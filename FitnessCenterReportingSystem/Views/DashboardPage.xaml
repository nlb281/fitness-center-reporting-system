<Page x:Class="FitnessCenterReportingSystem.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:FitnessCenterReportingSystem.Views"
      xmlns:lvc="http://schemas.livecharts.com/2.0/wpf"
      xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      Title="DashboardPage" 
      Height="720"
      Width="1280"
      Background="#F0F2F5">
    <Grid>

        <Border Margin="20"
                Background="White"
                CornerRadius="20">

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📈 Управленческий дашборд"
                           FontSize="28"
                           FontWeight="Bold"/>

                <UniformGrid Grid.Row="1"
                             Columns="5"
                             Margin="0,20,0,20">

                    <Border Background="#2C7DA0"
                            CornerRadius="12"
                            Margin="5"
                            Padding="15">

                        <StackPanel>
                            <TextBlock Text="Посетителей"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding TotalVisitors}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#10B981"
                            CornerRadius="12"
                            Margin="5"
                            Padding="15">

                        <StackPanel>
                            <TextBlock Text="Занятий"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding TotalSessions}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#F59E0B"
                            CornerRadius="12"
                            Margin="5"
                            Padding="15">

                        <StackPanel>
                            <TextBlock Text="Посещаемость"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding AttendancePercent,StringFormat={}{0}%}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#8B5CF6"
                            CornerRadius="12"
                            Margin="5"
                            Padding="15">

                        <StackPanel>
                            <TextBlock Text="Секций"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding SectionsCount}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#EF4444"
                            CornerRadius="12"
                            Margin="5"
                            Padding="15">

                        <StackPanel>
                            <TextBlock Text="Лидер"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding TopSection}"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                </UniformGrid>

                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        CornerRadius="15"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Посещаемость по секциям"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <wpf:CartesianChart
                            Series="{Binding VisitorsSeries}"
                            XAxes="{Binding XAxes}"
                            Height="400"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>
</Page>
