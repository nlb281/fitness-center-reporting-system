<Page x:Class="FitnessCenterReportingSystem.Views.AttendanceReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:FitnessCenterReportingSystem.Views"
      mc:Ignorable="d"
      Title="SectionsAnalyticsPage" 
      Height="720"
      Width="1280"
      Background="#F0F2F5">

    <Grid>

        <Border Margin="20"
                Background="White"
                CornerRadius="25">

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                

                <StackPanel>
                    <TextBlock Text="Система управленческой отчетности ФОК"
                               FontSize="30"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Оперативный отчет по посещаемости"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,25,0,20">

                    <Button Content="Обновить данные"
                            Width="160"
                            Height="40"
                            Margin="0,0,10,0"
                            Background="#2C7DA0"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ReloadButton_Click"/>

                    <Button Content="Экспорт CSV"
                            Width="160"
                            Height="40"
                            Background="#10B981"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ExportCsvButton_Click"/>
                </StackPanel>

                <UniformGrid Grid.Row="2"
                             Columns="3"
                             Margin="0,0,0,20">

                    <Border Background="#2C7DA0"
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="Посетителей"
                                       Foreground="White"
                                       FontSize="14"/>

                            <TextBlock Text="{Binding TotalVisitors}"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#10B981"
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="Посещаемость"
                                       Foreground="White"
                                       FontSize="14"/>

                            <TextBlock Text="{Binding AttendancePercent}"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#F59E0B"
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="Количество занятий"
                                       Foreground="White"
                                       FontSize="14"/>

                            <TextBlock Text="{Binding Visits.Count}"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                </UniformGrid>

                <Border Grid.Row="3"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="15">

                    <DataGrid ItemsSource="{Binding Visits}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0"
                              FontSize="14">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Дата"
                                                Width="*"
                                                Binding="{Binding Date}" />

                            <DataGridTextColumn Header="Секция"
                                                Width="*"
                                                Binding="{Binding Section.Name}" />

                            <DataGridTextColumn Header="Тренер"
                                                Width="*"
                                                Binding="{Binding Coach.Fio}" />

                            <DataGridTextColumn Header="Записано"
                                                Width="*"
                                                Binding="{Binding RegisteredVisitors}" />

                            <DataGridTextColumn Header="Посетило"
                                                Width="*"
                                                Binding="{Binding AttendedVisitors}" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>