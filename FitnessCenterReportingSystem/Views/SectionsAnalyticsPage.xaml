<Page x:Class="FitnessCenterReportingSystem.Views.SectionsAnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:FitnessCenterReportingSystem.Views"
      mc:Ignorable="d"
      Title="SectionsAnalyticsPage" 
      Height="720"
      Width="1280"
      Background="#F0F2F5">
    <Grid>

        <Border Margin="20"
                Background="White"
                CornerRadius="25">

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                

                <StackPanel>
                    <TextBlock Text="Аналитический отчет"
                               FontSize="30"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Популярность спортивных секций"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,5,0,0"/>
                </StackPanel>
                

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,25,0,20">

                    <Button Content="Обновить данные"
                            Width="160"
                            Height="40"
                            Margin="0,0,10,0"
                            Background="#2C7DA0"
                            Foreground="White"/>

                    <Button Content="Экспорт CSV"
                            Width="160"
                            Height="40"
                            Background="#10B981"
                            Foreground="White"/>
                </StackPanel>

                <UniformGrid Grid.Row="2"
                             Columns="3"
                             Margin="0,0,0,20">

                    <Border Background="#2C7DA0"
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="Популярная секция"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding MostPopularSection}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="22"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#10B981"
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="Всего посещений"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding TotalVisitors}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="22"/>
                        </StackPanel>

                    </Border>

                    <Border Background="#F59E0B"
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="Количество секций"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding SectionsCount}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="22"/>
                        </StackPanel>

                    </Border>

                </UniformGrid>

                <Border Grid.Row="3"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="15">

                    <DataGrid ItemsSource="{Binding Sections}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              AlternatingRowBackground="#F8FAFC">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Секция"
                                                Width="*"
                                                Binding="{Binding SectionName}" />

                            <DataGridTextColumn Header="Количество посетителей"
                                                Width="*"
                                                Binding="{Binding TotalVisitors}" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>
